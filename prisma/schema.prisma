generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ana Kategoriler: Kadın, Erkek, Çocuk, İndirim vb.
model MainCategory {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  imageUrl       String?
  isShowOnNavbar Boolean       @default(false) 
  
  subCategories  SubCategory[]
  createdAt      DateTime      @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Alt Kategoriler: Gömlek, Pantolon, Etek vb.
model SubCategory {
  id             Int          @id @default(autoincrement())
  name           String
  
  // Hangi ana kategoriye ait? (Örn: Kadın -> Gömlek)
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)

  // Bir ürün birden fazla alt kategoride olabilir (Many-to-Many)
  products       Product[]    
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  
  // ✅ YENİ: İNDİRİM SİSTEMİ
  discountPrice Decimal? @db.Decimal(10, 2) // İndirimli fiyat (varsa)
  isOnSale      Boolean  @default(false)     // İndirimde mi?
  
  stock       Int      @default(0)
  imageUrl    String?  
  isFeatured  Boolean  @default(false)
  
  categories  SubCategory[] 

  // ✅ YENİ: DETAYLI BİLGİLER
  productDetails ProductDetail[]
  
  viewCount     Int      @default(0)  // Kaç kişi ürünü görüntüledi
  favoriteCount Int      @default(0)  // Kaç kişi favorilere ekledi
  cartAddCount  Int      @default(0)  // Kaç kişi sepete ekledi

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  favoritedBy Favorite[]
  orderItems  OrderItem[]
  isActive    Boolean  @default(true)
  reviews     Review[]
}

model ProductDetail {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sectionType String  // "DESCRIPTION", "FEATURES", "SPECIFICATIONS", "CARE"
  title       String? // Bölüm başlığı (opsiyonel)
  content     String  @db.Text // Detay içeriği
  order       Int     @default(0) // Sıralama
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([productId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  size      String  // Örn: "S", "M", "L", "42", "44"
  color     String  @default("Standart")
  stock     Int     // O bedene ait stok
  vImageUrl String?
  vImageUrls String[] @default([])

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}


// Admin girişi için basit bir yapı
model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique // Aynı mail ile tekrar kayıt olunamaz
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  favorites Favorite[]
  addresses Address[]
  orders    Order[]
  payments  Payment[]
  cart      Cart?
  reviews   Review[]
}

model Cart {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int       @unique
  items          Json      @default("[]") // Sepet ürünleri JSON olarak saklanır
  updatedAt      DateTime  @updatedAt
  reminderSentAt DateTime? // Son hatırlatma e-postası gönderilme tarihi
}

model Favorite {
  id        Int      @id @default(autoincrement())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Aynı kullanıcı aynı ürünü 2 kere favorileyemesin
}


model Address {
  id        Int      @id @default(autoincrement())
  title     String   // Örn: Ev, İş
  address   String   // Açık adres metni
  city      String   // Şehir
  phone     String   // İletişim numarası
  
  // Hangi kullanıcıya ait?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  createdAt DateTime @default(now())
}

enum OrderStatus {
  ODEME_BEKLENIYOR
  SIPARIS_ALINDI
  HAZIRLANIYOR
  KARGOLANDI
  TESLIM_EDILDI
  IPTAL_EDILDI
  IADE_EDILDI
}

enum ReturnStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}


model Order {
  id              Int            @id @default(autoincrement())
  user            User           @relation(fields: [userId], references: [id])
  userId          Int
  
  status          OrderStatus    @default(SIPARIS_ALINDI)
  total           Decimal        @db.Decimal(10, 2)
  addressSnapshot String
  
  // Kupon bilgileri
  couponCode      String?
  couponId        Int?           
  coupon          Coupon?        @relation("CouponOrders", fields: [couponId], references: [id])
  discountAmount  Decimal        @db.Decimal(10, 2) @default(0)
  
  // Ödeme bilgileri
  paymentStatus   PaymentStatus? @default(PENDING)
  paymentMethod   String?        @default("PAYTR")
  
  invoiceType     String?        // "INDIVIDUAL" veya "CORPORATE"
  
  // Bireysel Fatura (TC Kimlik No)
  tcNo            String?
  
  // Kurumsal Fatura
  companyName     String?
  taxOffice       String?
  taxNumber       String?
  
  invoiceAddress  String?
  
  trackingNumber  String?        // Kargo takip numarası
  cargoCompany    String?        // Kargo şirketi (Aras, Yurtiçi, MNG vb.)
  
  returnRequest   ReturnRequest?
  items           OrderItem[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
}


model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  
  price     Decimal  @db.Decimal(10, 2) // Satın alındığı andaki fiyat
  quantity  Int
  variant   String?  // "S / Siyah" gibi
}


model ReturnRequest {
  id        Int          @id @default(autoincrement())
  
  orderId   Int          @unique // Bir sipariş için tek talep
  order     Order        @relation(fields: [orderId], references: [id])
  
  status    ReturnStatus @default(BEKLIYOR)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE  // Yüzde İndirim (Örn: %10)
  FIXED_AMOUNT // Sabit Tutar (Örn: 100 TL)
}

model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  expirationDate DateTime?
  isActive       Boolean      @default(true)
  
  usageLimit     Int?         // Toplam kaç kere kullanılabilir (null = sınırsız)
  usedCount      Int          @default(0) // Şu ana kadar kaç kere kullanıldı
  
  createdAt      DateTime     @default(now())
  
  orders         Order[]      @relation("CouponOrders")
}
enum PaymentStatus {
  PENDING      // Ödeme bekleniyor
  SUCCESS      // Başarılı
  FAILED       // Başarısız
  CANCELLED    // İptal edildi
  REFUNDED     // İade edildi
}

model Review {
  id        Int      @id @default(autoincrement())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  rating    Int      // 1-5 yıldız
  comment   String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId]) // Kullanıcı aynı ürüne 2 kere yorum yapmasın
  @@index([productId])
  @@index([userId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique // Sipariş ID (merchant_oid)
  userId        Int?          // Kullanıcı ID
  
  // Ödeme Bilgileri
  amount        Decimal       @db.Decimal(10, 2) // Toplam tutar
  currency      String        @default("TL")
  status        PaymentStatus @default(PENDING)
  paymentMethod String        @default("PAYTR")
  
  // PayTR Özel Alanlar
  paytrToken    String?       // PayTR Token
  totalAmount   Decimal?      @db.Decimal(10, 2) // PayTR'den gelen toplam tutar
  failureReason String?       // Başarısız ödeme nedeni
  
  // Tarihler
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?     // Ödeme yapıldı tarihi
  
  // İlişkiler
  user          User?         @relation(fields: [userId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id])
  
  @@index([orderId])
  @@index([userId])
  @@index([status])
}
