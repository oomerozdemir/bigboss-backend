generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ana Kategoriler: Kadın, Erkek, Çocuk, İndirim vb.
model MainCategory {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?
  imageUrl       String?
  isShowOnNavbar Boolean       @default(false) 
  
  subCategories  SubCategory[]
  createdAt      DateTime      @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Alt Kategoriler: Gömlek, Pantolon, Etek vb.
model SubCategory {
  id             Int          @id @default(autoincrement())
  name           String
  
  // Hangi ana kategoriye ait? (Örn: Kadın -> Gömlek)
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)

  // Bir ürün birden fazla alt kategoride olabilir (Many-to-Many)
  products       Product[]    
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?  
  isFeatured  Boolean  @default(false)
  
  categories  SubCategory[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
  favoritedBy Favorite[]
  orderItems  OrderItem[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  size      String  // Örn: "S", "M", "L", "42", "44"
  color     String  @default("Standart")
  stock     Int     // O bedene ait stok
  vImageUrl String?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
}


// Admin girişi için basit bir yapı
model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique // Aynı mail ile tekrar kayıt olunamaz
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  favorites Favorite[]
  addresses Address[]
  orders    Order[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  createdAt DateTime @default(now())

  @@unique([userId, productId]) // Aynı kullanıcı aynı ürünü 2 kere favorileyemesin
}


model Address {
  id        Int      @id @default(autoincrement())
  title     String   // Örn: Ev, İş
  address   String   // Açık adres metni
  city      String   // Şehir
  phone     String   // İletişim numarası
  
  // Hangi kullanıcıya ait?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  createdAt DateTime @default(now())
}

enum OrderStatus {
  SIPARIS_ALINDI
  HAZIRLANIYOR
  KARGOLANDI
  TESLIM_EDILDI
  IPTAL_EDILDI
  IADE_EDILDI
}

enum ReturnStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}


model Order {
  id              Int         @id @default(autoincrement())
  user            User        @relation(fields: [userId], references: [id])
  userId          Int
  
  status          OrderStatus @default(SIPARIS_ALINDI)
  total           Decimal     @db.Decimal(10, 2)       // Toplam Tutar
  addressSnapshot String      // Sipariş anındaki adres metni (Adres silinse bile kalsın diye)
  
  couponCode      String?     
  discountAmount  Decimal

  returnRequest   ReturnRequest?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  
  price     Decimal  @db.Decimal(10, 2) // Satın alındığı andaki fiyat
  quantity  Int
  variant   String?  // "S / Siyah" gibi
}


model ReturnRequest {
  id        Int          @id @default(autoincrement())
  
  orderId   Int          @unique // Bir sipariş için tek talep
  order     Order        @relation(fields: [orderId], references: [id])
  
  status    ReturnStatus @default(BEKLIYOR)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE  // Yüzde İndirim (Örn: %10)
  FIXED_AMOUNT // Sabit Tutar (Örn: 100 TL)
}

model Coupon {
  id             Int          @id @default(autoincrement())
  code           String       @unique // Kupon Kodu (Örn: YAZ2024)
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2) // İndirim miktarı
  minOrderAmount Decimal?     @db.Decimal(10, 2) // Minimum sepet tutarı (Opsiyonel)
  expirationDate DateTime?    // Son kullanma tarihi
  isActive       Boolean      @default(true)
  usageLimit     Int?         // Kaç kere kullanılabilir (Opsiyonel)
  
  createdAt      DateTime     @default(now())
}